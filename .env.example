# ====================================================================
# Environment Configuration Template for PetReg Irosin
# Copy this file to .env or .env.local when deploying
# ====================================================================

# Supabase Project Credentials (from https://supabase.com/dashboard/project/<id>/settings/api)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: VAPID Public Key for Server Web Push (generate via web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
